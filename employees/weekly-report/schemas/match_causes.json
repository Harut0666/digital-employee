{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "原因匹配结果",
  "description": "为每条异常匹配纪要中的原因，并把纪要中的可核验说法抽成固定格式。是否构成纪要矛盾由程序按阈值判定，这里只抽取。",
  "type": "object",
  "additionalProperties": false,
  "required": ["causes", "claims"],
  "properties": {
    "causes": {
      "type": "array",
      "description": "每条异常恰好一条原因，anomalyId 取自输入的异常清单；与 DraftReport.causes 同形。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anomalyId", "cause", "level"],
        "properties": {
          "anomalyId": { "type": "string", "minLength": 1, "description": "异常编号，如 store:HZ01、region:华南。" },
          "cause": { "type": "string", "minLength": 1, "description": "原因摘要。沿用上级原因时在末尾加“（区域整体原因）”或“（店型整体原因）”；纪要没提到时只写“原因待核实”。" },
          "level": {
            "type": "string",
            "enum": ["store", "store_type", "region", "company", "unknown"],
            "description": "原因所针对的范围；没有原因时为 unknown。"
          },
          "sourceWeek": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year", "week"],
            "properties": { "year": { "type": "integer" }, "week": { "type": "integer" } },
            "description": "原因出自哪一周的纪要；level 为 unknown 时省略。"
          },
          "quote": { "type": "string", "minLength": 1, "description": "原文摘录，逐字取自所注周次纪要的连续片段；level 为 unknown 时省略。" }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "纪要中针对数据里有的指标所作的判断（可核验说法）；没有就提交空数组。客流、口感等数据里没有的说法不抽取。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "metric", "direction", "sourceWeek", "quote"],
        "properties": {
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "key"],
            "properties": {
              "level": { "type": "string", "enum": ["company", "region", "store", "category"], "description": "说法针对的对象类型。" },
              "key": { "type": "string", "minLength": 1, "description": "对象的业务键：全公司写 company；区域写区域名，如 华南；门店写门店编码，如 SH02；品类写品类名。" }
            }
          },
          "metric": { "type": "string", "enum": ["wow"], "description": "指标。目前只核验实收环比，纪要里“销售上升/下降/持平”都归为 wow。" },
          "direction": { "type": "string", "enum": ["flat", "up", "down"], "description": "纪要说的方向：持平、上升、下降。" },
          "magnitude": { "type": "number", "minimum": 0, "description": "纪要给出的幅度，按小数写（两成写 0.2，约七成写 0.7）；纪要没给幅度时省略。" },
          "sourceWeek": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year", "week"],
            "properties": { "year": { "type": "integer" }, "week": { "type": "integer" } },
            "description": "说法出自哪一周的纪要。"
          },
          "quote": { "type": "string", "minLength": 1, "description": "原文摘录，逐字取自所注周次纪要的连续片段。" }
        }
      }
    }
  }
}
