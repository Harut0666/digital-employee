  "steps": [
    {
      "actor": "initiator",
      "command": {
        "type": "submit"
      },
      "expect": {
        "state": "awaiting_initiator",
        "pauseCode": "minutes_missing"
      }
    },
    {
      "actor": "initiator",
      "command": {
        "type": "continue_without_minutes"
      },
      "expect": {
        "state": "awaiting_review",
        "pauseCode": "awaiting_review"
      }
    },
    {
      "actor": "reviewer",
      "command": {
        "type": "approve"
      },
      "expect": {
        "state": "delivered",
        "deliverables": [
          "docx",
          "qc_record"
        ]
      }
    }
  ],
  "expect": {
    "state": "delivered",
    "checks": {
      "numbers": [
        {
          "path": "table:全公司/实收（元）",
          "expected": 573635
        },
        {
          "path": "table:全公司/环比",
          "expected": -9.3
        },
        {
          "path": "table:全公司/目标达成率",
          "expected": 89.8
        },
        {
          "path": "facts:company.deliveryShare",
          "expected": 31.8
        },
        {
          "path": "facts:quality.returns.count",
          "expected": 11
        }
      ],
      "mustContain": [
        "原因待核实"
      ],
      "mustNotContain": [
        "客单价",
        "同比"
      ],
      "anomalies": [
        "region:华东",
        "region:华南",
        "store:SH02",
        "store:HZ01",
        "store:SZ01",
        "store:SZ02"
      ],
      "pause": {
