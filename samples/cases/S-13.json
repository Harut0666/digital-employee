{
  "id": "S-13",
  "title": "缺材料：第 44 周缺纪要，选择“无纪要继续”后交付",
  "employee": "weekly-report",
  "form": {
    "period": {
      "year": 2026,
      "week": 44
    }
  },
  "attachments": [
    {
      "name": "销售明细.xlsx",
      "path": "../scenario-a/销售明细.xlsx"
    }
