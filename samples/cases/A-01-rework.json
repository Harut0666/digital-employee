{
  "id": "A-01-rework",
  "title": "A-01 变体：审核退回 → 重做 → 修改说明覆盖意见 → 通过",
  "employee": "weekly-report",
  "form": { "period": { "year": 2026, "week": 44 } },
  "attachments": [
    { "name": "销售明细.xlsx", "path": "../scenario-a/销售明细.xlsx" },
    { "name": "周会纪要_2026W44.docx", "path": "../scenario-a/周会纪要_2026W44.docx" }
  ],
  "steps": [
    { "actor": "initiator", "command": { "type": "submit" }, "expect": { "state": "awaiting_review", "pauseCode": "awaiting_review" } },
    { "actor": "initiator", "command": { "type": "approve" }, "expect": { "ok": false, "error": "forbidden_role", "state": "awaiting_review" } },
    {
      "actor": "reviewer",
      "command": { "type": "return", "comment": "摘要请再精简，突出本周最重要的两个异常。", "sections": ["summary"] },
      "expect": { "state": "awaiting_review", "pauseCode": "awaiting_review" }
    },
    { "actor": "reviewer", "command": { "type": "approve" }, "expect": { "state": "delivered", "deliverables": ["docx", "qc_record"] } }
  ],
  "expect": {
    "state": "delivered",
    "checks": {
      "numbers": [
        { "path": "table:全公司/实收（元）", "expected": 573635 },
        { "path": "table:全公司/环比", "expected": -9.3 },
        { "path": "table:华东/环比", "expected": -12.0 },
        { "path": "table:华南/环比", "expected": -12.7 },
        { "path": "facts:quality.returns.count", "expected": 11 }
      ],
      "mustContain": ["以数据为准", "商场消防改造停业三天", "第二杯半价", "退货 11 笔"],
      "mustNotContain": ["客单价", "同比"],
      "anomalies": ["region:华东", "region:华南", "store:HZ01", "store:SH02"]
    }
  }
}
