{
  "id": "T-05",
  "title": "终止（等待补充材料）：材料有问题，发起人决定终止 → 已终止",
  "employee": "weekly-report",
  "form": {
    "period": {
      "year": 2026,
      "week": 44
    }
  },
  "attachments": [
