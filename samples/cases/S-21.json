{
  "id": "S-21",
  "title": "流程：连续两次退回（摘要与核心指标各一次）→ 重做 → 通过",
  "employee": "weekly-report",
  "form": {
    "period": {
      "year": 2026,
      "week": 44
    }
  },
  "attachments": [
    {
      "name": "销售明细.xlsx",
      "path": "../scenario-a/销售明细.xlsx"
    },
    {
      "name": "周会纪要_2026W44.docx",
      "path": "../scenario-a/周会纪要_2026W44.docx"
    }
  ],
  "steps": [
    {
      "actor": "initiator",
      "command": {
        "type": "submit"
      },
      "expect": {
        "state": "awaiting_review",
        "pauseCode": "awaiting_review"
      }
    },
    {
      "actor": "reviewer",
      "command": {
        "type": "return",
        "comment": "摘要请再精简，突出本周最重要的两个异常。",
        "sections": [
          "summary"
        ]
      },
      "expect": {
        "state": "awaiting_review",
        "pauseCode": "awaiting_review"
      }
    },
    {
      "actor": "reviewer",
      "command": {
        "type": "return",
        "comment": "核心指标一章请补一句目标达成率的整体判断。",
        "sections": [
          "metrics"
        ]
      },
      "expect": {
        "state": "awaiting_review",
        "pauseCode": "awaiting_review"
      }
    },
    {
      "actor": "reviewer",
      "command": {
        "type": "approve"
      },
      "expect": {
        "state": "delivered",
        "deliverables": [
          "docx",
          "qc_record"
        ]
      }
    }
  ],
  "expect": {
    "state": "delivered",
    "checks": {
      "numbers": [
        {
          "path": "table:全公司/实收（元）",
          "expected": 573635
        },
        {
          "path": "table:全公司/环比",
          "expected": -9.3
        },
        {
          "path": "table:全公司/目标达成率",
          "expected": 89.8
        },
        {
          "path": "facts:company.deliveryShare",
          "expected": 31.8
        },
        {
          "path": "facts:quality.returns.count",
          "expected": 11
        }
      ],
      "mustContain": [
        "华东与华南是本周两个异常区域",
        "目标达成率"
      ],
      "mustNotContain": [
        "客单价",
        "同比"
      ],
      "anomalies": [
        "region:华东",
        "region:华南",
        "store:SH02",
        "store:HZ01",
        "store:SZ01",
        "store:SZ02"
      ]
    }
  }
}
