  "write_brief": [
    {
      "toolCalls": [
        {
          "arguments": {
            "sections": [
              {
                "claims": [
                  {
                    "cites": [
                      "ZZ2021355204B"
                    ],
                    "text": "纳入分析的发明共 36 项，聚阴离子路线最多（14 件）。"
                  },
                  {
                    "cites": [
                      "ZZ2022524830B"
                    ],
                    "text": "申请量最高的是申请人E09，共 13 项发明。"
                  },
                  {
                    "cites": [
                      "ZZ2025554838A",
                      "ZZ2024490892A"
                    ],
                    "text": "2024–2026 年的申请量因专利公开滞后而不完整，趋势判断需谨慎。"
                  },
                  {
                    "cites": [
                      "ZZ2021117740B",
                      "ZZ2020294782B"
                    ],
                    "text": "高校、科研院所已有 2 件专利发生转让或许可，转化已有先例。"
                  },
                  {
                    "cites": [
                      "ZZ2020492484B"
                    ],
                    "text": "尚未转让的高校、科研院所专利中，有被引较多、状态有效的专利值得接洽。"
                  }
                ],
                "id": "summary"
              },
              {
                "claims": [
                  {
                    "cites": [
                      "LW0070"
                    ],
                    "text": "论文库中有同方向的研究，可作为专利之外的佐证。"
                  }
                ],
                "id": "overview"
              },
              {
                "claims": [
                  {
                    "cites": [
                      "ZZ2021355204B"
                    ],
                    "route": "聚阴离子",
                    "text": "聚阴离子路线共 14 件。代表专利“一种碳包覆聚阴离子型正极材料的制备方法”针对低温下聚阴离子材料容量衰减明显的问题，本发明原位引入三维导电碳网络，改善了低温下的离子与电子传输；实施例表明，0.1C 放电比容量为 104 mAh/g，-20℃ 下容量保持率为常温的 87%。"
                  },
                  {
                    "cites": [
                      "ZZ2020492484B"
                    ],
                    "route": "层状氧化物",
                    "text": "层状氧化物路线共 13 件。代表专利“一种P2 型层状氧化物正极材料的连续化制备方法”针对单一元素体系难以兼顾容量与循环的问题，本发明采用高熵设计稳定晶体结构，在较高比容量下兼顾了循环稳定性；实施例表明，0.1C 首次放电比容量为 130 mAh/g，1C 循环 2000 圈后容量保持率为 88%。"
                  },
                  {
                    "cites": [
                      "ZZ2019480418A"
                    ],
                    "route": "普鲁士蓝类",
                    "text": "普鲁士蓝类路线共 9 件。代表专利“一种改性普鲁士蓝/碳复合正极材料及其制备方法”针对普鲁士蓝材料结晶水含量高，影响循环和安全性的问题，本发明通过梯度真空干燥去除结晶水，降低了结晶水含量；实施例表明，0.1C 放电比容量为 127 mAh/g，1C 循环 1000 圈后容量保持率为 80%。"
                  }
                ],
                "id": "routes"
              },
              {
                "claims": [
                  {
                    "cites": [
                      "ZZ2025554838A"
                    ],
                    "text": "整体看，近三年（2023 年起）的申请占 50.0%，但最近两年的数据因公开滞后不完整，不能据此判断下滑。"
                  },
                  {
                    "cites": [
                      "ZZ2021355204B"
                    ],
                    "text": "聚阴离子路线近三年（2023 年起）申请占该路线的 78.6%，高于整体的 50.0%，近年更活跃。"
                  }
                ],
                "id": "trend"
              },
              {
                "claims": [
                  {
                    "cites": [
                      "ZZ2022524830B"
                    ],
                    "text": "申请人E09以 13 项发明领先，申请人以企业为主，高校和科研院所也有参与。"
                  }
                ],
                "id": "applicants"
              },
              {
                "claims": [
                  {
                    "cites": [
                      "ZZ2021117740B",
                      "ZZ2020294782B"
                    ],
                    "text": "已发生的转让集中在少数几家受让方，说明这些高校、科研院所的成果有被承接的先例。"
                  },
                  {
                    "cites": [
                      "ZZ2020492484B",
                      "ZZ2020509537B",
                      "ZZ2022404875B"
                    ],
                    "text": "值得接洽的专利按被引次数排序，依据是法律状态有效或在实质审查中、尚未转让。"
                  }
                ],
                "id": "leads"
              },
              {
                "claims": [
                  {
                    "cites": [],
                    "text": "性能指标均来自专利摘要的自述，未经独立验证。"
                  }
                ],
                "id": "risks"
              }
            ],
            "title": "钠离子电池正极材料技术研判简报"
          },
          "name": "submit_result"
        }
