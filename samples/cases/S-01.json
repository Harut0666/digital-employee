{
  "id": "S-01",
  "title": "正常：第 40 周无纪要，选择“无纪要继续”后交付",
  "employee": "weekly-report",
  "form": {
    "period": {
      "year": 2026,
      "week": 40
    }
  },
  "attachments": [
    {
      "name": "销售明细.xlsx",
      "path": "../scenario-a/销售明细.xlsx"
    }
  ],
  "steps": [
    {
      "actor": "initiator",
      "command": {
        "type": "submit"
      },
      "expect": {
        "state": "awaiting_initiator",
        "pauseCode": "minutes_missing"
      }
    },
    {
      "actor": "initiator",
      "command": {
        "type": "continue_without_minutes"
      },
      "expect": {
        "state": "awaiting_review",
        "pauseCode": "awaiting_review"
      }
    },
    {
      "actor": "reviewer",
      "command": {
        "type": "approve"
      },
      "expect": {
        "state": "delivered",
        "deliverables": [
          "docx",
          "qc_record"
        ]
      }
    }
  ],
  "expect": {
    "state": "delivered",
    "checks": {
      "numbers": [
        {
          "path": "table:全公司/实收（元）",
          "expected": 672486
        },
        {
          "path": "table:全公司/环比",
          "expected": -1.4
        },
        {
          "path": "table:全公司/目标达成率",
          "expected": 94.1
        },
        {
          "path": "facts:company.deliveryShare",
          "expected": 31
        },
        {
          "path": "facts:quality.returns.count",
          "expected": 16
        }
      ],
      "mustContain": [
        "原因待核实",
        "数据质量说明"
      ],
      "mustNotContain": [
        "客单价",
        "同比"
      ],
      "anomalies": [
        "store:HZ01",
        "store:HZ02",
        "store:SZ02",
        "store:BJ02",
        "store:CD02"
      ]
    }
  }
}
