{
  "id": "S-05",
  "title": "边界：第 36 周（数据首周，无上周可比）",
  "employee": "weekly-report",
  "form": {
    "period": {
      "year": 2026,
      "week": 36
    }
  },
  "attachments": [
    {
      "name": "销售明细.xlsx",
      "path": "../scenario-a/销售明细.xlsx"
    }
  ],
  "steps": [
    {
      "actor": "initiator",
      "command": {
        "type": "submit"
      },
      "expect": {
        "state": "awaiting_initiator",
        "pauseCode": "minutes_missing"
      }
    },
    {
      "actor": "initiator",
      "command": {
        "type": "continue_without_minutes"
      },
      "expect": {
        "state": "awaiting_review",
        "pauseCode": "awaiting_review"
      }
    },
    {
      "actor": "reviewer",
      "command": {
        "type": "approve"
      },
      "expect": {
        "state": "delivered",
        "deliverables": [
          "docx",
          "qc_record"
        ]
      }
    }
  ],
  "expect": {
    "state": "delivered",
    "checks": {
      "numbers": [
        {
          "path": "table:全公司/实收（元）",
          "expected": 588099
        },
        {
          "path": "table:全公司/目标达成率",
          "expected": 96.7
        },
        {
          "path": "facts:company.deliveryShare",
          "expected": 30.7
        },
        {
          "path": "facts:quality.returns.count",
          "expected": 14
        }
      ],
      "mustContain": [
        "原因待核实",
        "数据质量说明"
      ],
      "mustNotContain": [
        "客单价",
        "同比"
      ]
    }
  }
}
