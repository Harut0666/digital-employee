{
  "name": "digital-employee",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "employees"],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "dev:server": "bun run --filter @de/server dev",
    "dev:web": "bun run --filter @de/web dev",
    "gen:assets": "bun scripts/gen-embedded.ts",
    "build:exe": "bun scripts/build-exe.ts",
    "build:desktop": "bun scripts/build-desktop.ts",
    "dev:desktop": "hutch electrobun dev --env=stable --watch",
    "smoke:exe": "powershell -ExecutionPolicy Bypass -File scripts/smoke-exe.ps1",
    "smoke:desktop": "powershell -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "ajv": "^8.20.0",
    "typescript": "^5.9.0"
  }
}
