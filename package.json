{
  "name": "digital-employee",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test packages/web",
    "typecheck": "bun run --filter '*' typecheck",
    "dev:web": "bun run --filter @de/web dev",
    "build:web": "bun run --filter @de/web build",
    "build:exe": "powershell -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "smoke:exe": "powershell -ExecutionPolicy Bypass -File scripts/smoke-exe.ps1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
